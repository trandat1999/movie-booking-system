# Sao chép thành .env rồi chỉnh nếu cần. docker compose tự đọc file .env này.
# Backend (profile dev) đọc các biến cùng tên từ biến môi trường của shell/IDE; nếu không đặt thì dùng giá trị
# mặc định trong application-dev.yml (trùng với giá trị bên dưới).

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=moviebooking
DB_USERNAME=moviebooking
DB_PASSWORD=moviebooking

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Backend
SERVER_PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300
